# Скопируй этот файл в .env и подставь свои значения:
#   cp .env.example .env
#
# Токен бота — получить у @BotFather в Telegram (команда /newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Твой chat_id — узнать через @userinfobot, или см. README.md
TELEGRAM_CHAT_ID=123456789

# id поликлиники и специальности на gorzdrav.spb.ru (по умолчанию — офтальмолог, пол. 180)
LPU_ID=180
SPECIALITY_ID=49

# Как часто проверять, в секундах (300 = раз в 5 минут)
POLL_INTERVAL_SECONDS=300
